# DemandIQ frontend — nginx config for Railway (and any non-compose host).
#
# Render target: /etc/nginx/conf.d/default.conf, written at container start by
# frontend/entrypoint.railway.sh. The three __PLACEHOLDERS__ are substituted
# there, so nothing in this file depends on Docker Compose:
#
#   __PORT__         the port to listen on (Railway injects PORT; 8080 locally)
#   __API_UPSTREAM__ host:port of the FastAPI service, reached over the private
#                    network as <service>.railway.internal:<port>
#   __RESOLVER__      nameserver(s) from the container's own /etc/resolv.conf
#
# The compose file (frontend/nginx.conf) is deliberately NOT this file: it
# hardcodes `backend:8000` and Docker's embedded DNS at 127.0.0.11, neither of
# which exists on Railway. Keeping them separate means a compose `up` and a
# Railway deploy cannot half-break each other.
#
# Two things here are load-bearing rather than stylistic:
#
#   1. proxy_pass goes through a variable plus an explicit `resolver`. A literal
#      upstream name is resolved ONCE at config load: if the API service is not
#      up yet, nginx fails to start with "host not found in upstream" and
#      crash-loops; and if the API is later redeployed on a different address,
#      nginx keeps dialling the stale one. With the variable form the lookup
#      happens per request, so a 502 during API rollout recovers by itself.
#   2. client_max_body_size is raised from nginx's 1 MB default. The ingestion
#      screens upload Excel/CSV datasets and phone photos; left at the default,
#      every upload fails with 413 before Python sees it.

# --- http-level: WebSocket upgrade + compression ----------------------------
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       __PORT__;
    server_name  _;

    # Redirects must stay relative: behind Railway's edge the container sees
    # http on a private port, and an absolute redirect would send the browser
    # to http://<container>:<port>/...
    absolute_redirect off;

    root  /usr/share/nginx/html;
    index index.html;

    # Uploads: see note 2 above. Keep in step with any future backend cap.
    client_max_body_size 50m;
    client_body_timeout  300s;

    # Per-request resolution of the API service (see note 1 above).
    resolver __RESOLVER__ valid=10s;
    set $upstream http://__API_UPSTREAM__;

    # Inference, SHAP and policy simulation are not instant; the default 60s
    # read timeout cuts off long requests the API would have answered.
    proxy_connect_timeout 10s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;

    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   X-Forwarded-Host  $host;
    proxy_set_header   Upgrade           $http_upgrade;
    proxy_set_header   Connection        $connection_upgrade;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/xml image/svg+xml;

    # No Content-Security-Policy here on purpose. A correct policy has to
    # allowlist the Turnstile challenge host and Google's identity origins, and
    # getting that wrong breaks sign-in in a way that is very hard to diagnose
    # from a bundle. Ship CSP from the real edge, where it can be tuned per
    # environment. The headers below are the safe subset.
    add_header X-Content-Type-Options "nosniff"            always;
    add_header X-Frame-Options        "SAMEORIGIN"         always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # Container liveness only — deliberately not a proxy of the API's /health,
    # so an API outage does not get this container restarted.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------------------------------------------------------------------
    # API + docs, proxied to the FastAPI service.
    # ---------------------------------------------------------------------
    location /api/ {
        proxy_pass $upstream$request_uri;
    }

    location = /console      { proxy_pass $upstream$request_uri; }
    location = /health       { access_log off; proxy_pass $upstream$request_uri; }
    location = /openapi.json { proxy_pass $upstream$request_uri; }
    location = /docs         { proxy_pass $upstream$request_uri; }
    location = /redoc        { proxy_pass $upstream$request_uri; }

    # / opens the product UI. The API's own / returns a small JSON banner (or
    # the OpenAPI console), which looks like the frontend is missing when it is
    # the first URL someone tries. The console keeps its own path at /console.
    location = / {
        return 302 /app/;
    }

    # Everything else that is not a bundle path goes to the API.
    location / {
        proxy_pass $upstream$request_uri;
    }

    # ---------------------------------------------------------------------
    # The SPA, under /app/ because vite.config.ts compiles `base: '/app/'`.
    # ---------------------------------------------------------------------
    location = /app {
        return 301 /app/;
    }

    # Vite emits content-hashed filenames into /app/assets, so they can be
    # cached immutably. try_files =404 (not the SPA fallback) so a stale
    # index.html asking for a deleted chunk gets an honest 404 instead of
    # being handed HTML as a script.
    #
    # NOTE: `expires 1y` is deliberately not used. It emits its own
    # Cache-Control: max-age=..., which would land alongside the immutable one
    # below as a duplicate header.
    #
    # NOTE: the security headers are repeated in every location that sets
    # add_header. nginx's add_header does not merge with inherited values — one
    # add_header in a location discards ALL of the server-level ones.
    location /app/assets/ {
        add_header Cache-Control          "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff"            always;
        add_header X-Frame-Options        "SAMEORIGIN"         always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        try_files  $uri =404;
    }

    # Client-side routing: /app/ingestion, /app/quality and friends are not files
    # on disk, so any miss falls through to the SPA shell.
    location /app/ {
        try_files $uri $uri/ /app/index.html;
    }

    # index.html must never be cached, or a deploy leaves clients requesting
    # asset filenames that no longer exist. Security headers repeated for the
    # add_header-replaces-inheritance reason noted above.
    location = /app/index.html {
        add_header Cache-Control          "no-cache, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff"            always;
        add_header X-Frame-Options        "SAMEORIGIN"         always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    }
}
