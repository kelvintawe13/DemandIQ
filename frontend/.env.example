# DemandIQ Frontend — Vite env (exposed as import.meta.env.VITE_*)
# Backend gateway (FastAPI) — must match backend/app/main.py and docker-compose
VITE_API_URL=http://localhost:8000
# Optional: override for staging/production
# VITE_API_URL=https://staging-api.demandiq.app

# ---------------------------------------------------------------------------
# PUBLIC identifiers only — everything with the VITE_ prefix is compiled into
# the browser bundle and is readable by anyone. Server secrets (Turnstile
# secret key, Google client secret) belong in backend/.env, never here.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile site key (public) — omit to disable the human check in dev
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# Dev/test helper (Cloudflare "always-pass" pair — dev only, never in production):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   Backend pair: backend/.env TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# IPv6 note: the challenge host (brunhild.challenges.cloudflare.com) is IPv6-only;
# on an IPv4-only LAN the widget will not solve — omit BOTH keys to skip the
# check locally (backend skips verification when TURNSTILE_SECRET is empty).
# Production MUST use a real site key from dash.cloudflare.com/turnstile.

# Google Identity Services client id (public) — required to enable the Google button
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Source: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# The SAME client id must be set in backend/.env as GOOGLE_OAUTH_CLIENT_ID (plus
# GOOGLE_OAUTH_CLIENT_SECRET). Frontend VITE_* values are public; the secret never
# leaves the backend.
#
# 403 "The given origin is not allowed for the given client ID" on localhost means
# the OAuth client has no Authorized JavaScript origin for that origin. Fix:
#   Google Cloud Console → OAuth client → Authorized JavaScript origins → add:
#     http://localhost:5173
#     http://localhost:5174
#   plus any deployed origin (e.g. https://demandiq.app). No code change can
#   bypass it — the button is intentionally disabled on blocked origins and the
#   GSI_LOGGER spam is suppressed (see frontend/src/lib/google.ts and
#   frontend/src/components/auth/GoogleButton.tsx). Dev fallback: email/password
#   sign-in still works; leave VITE_GOOGLE_CLIENT_ID unset to hide the button.
#
# Matching server-side credentials live in backend/.env:
#   TURNSTILE_SECRET, GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET
