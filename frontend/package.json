{
  "name": "@demandiq/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DemandIQ frontend — React UI for explainable demand forecasting (forecast + 90% adaptive conformal interval, SR/PS/UD policy simulation, SHAP explainer) — consumes FastAPI ForecastRequestAPI; Recruit + URBAN-WASTE boundary",
  "author": "Kelvin Tawe (African Leadership University, BSc Software Engineering, 2026)",
  "license": "PROPRIETARY",
  "keywords": [
    "react",
    "vite",
    "tailwind",
    "demand-forecasting",
    "food-waste",
    "explainable-ai",
    "shap"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/route-smoke.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "axe-core": "^4.13.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "jsdom": "^24.1.3",
    "playwright": "^1.63.0",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "defaults"
  ]
}
