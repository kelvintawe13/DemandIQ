# DemandIQ Backend — local development defaults (safe for CI, not production)
# See backend/app/config.py and backend/README.md for full list.
APP_ENV=development
APP_NAME=DemandIQ API
APP_VERSION=1.0.0
DEBUG=false
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/demandiq
REDIS_URL=redis://localhost:6379/0
# OBJECT_STORE_URL=
# OBJECT_STORE_KEY=
# OBJECT_STORE_SECRET=
JWT_SECRET=dev-only-change-me-32-chars-minimum-secret!!
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=14
TOTP_ISSUER=DemandIQ
# Cloudflare Turnstile secret — omit/empty to skip verification in dev/CI.
# Dev/test helper (Cloudflare "always-pass" pair — dev only, never in production):
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
#   Frontend pair: frontend/.env VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# IPv6 note: the widget host (brunhild.challenges.cloudflare.com) is IPv6-only;
# on IPv4-only networks the widget never issues a token and login will block
# when a secret is set. For local dev on such networks, leave this empty so
# backend/app/security/human.py:verify_turnstile skips verification; the
# siteverify host (challenges.cloudflare.com) itself has IPv4 and works fine
# when the network can reach it. Production MUST use a real secret.
# GOOGLE_OAUTH_CLIENT_ID — must match frontend/.env VITE_GOOGLE_CLIENT_ID (public id)
# GOOGLE_OAUTH_CLIENT_SECRET — never expose to the frontend; verified in
# backend/app/security/human.py:verify_google_id_token against Google's JWKS.
# 403 fix: Authorized JavaScript origins must include http://localhost:5173 and
# http://localhost:5174 for dev — see frontend/.env.example.
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# TURNSTILE_SECRET=
# MODEL_REGISTRY_URI=
#
# Serving bundle — the trained LightGBM booster + Mondrian ACI conformal state
# exported by `model/scripts/export_serving_bundle.py`. The API probes
# `model/artifacts/runs/latest/serving_bundle.joblib` by default, so a normal
# dev checkout needs nothing here; set it explicitly to deploy or to point at a
# pinned run. When unset and no artifact is found, forecasts come from the
# deterministic stub (rolling means) and are filed against the `v0-fallback`
# model version — see the boot log line "Serving: STUB forecasts".
# MODEL_BUNDLE_PATH=/srv/demandiq/serving_bundle.joblib
DEFAULT_COVERAGE=0.90
DEFAULT_PREP_QUANTILE=0.80
CORS_ORIGINS=["*"]
WEBHOOK_SIGNING_ALGO=hmac-sha256
LOG_LEVEL=INFO
# Honour X-Forwarded-For when deriving the rate-limit client key. Leave false
# unless a proxy in front of the API overwrites the header — it is
# caller-supplied, so trusting it lets a client pick its own rate-limit bucket.
TRUSTED_PROXY_HEADERS=false
# Background jobs: connector sync, recalibration, drift, report delivery.
# JOBS_ENABLED=false
# JOBS_TICK_SECONDS=60
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
